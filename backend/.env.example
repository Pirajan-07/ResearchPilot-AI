# ============================================================
# ResearchPilot AI — Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# === AI Providers ===
# Your Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use. Change this to swap models without code changes.
# Current default: gemini-3.5-flash (current-generation Flash model)
# WARNING: Changing EMBEDDING_MODEL requires re-indexing all documents.
GEMINI_MODEL=gemini-3.5-flash

# Local HuggingFace embedding model (downloaded to ~/.cache/huggingface/ on first run)
# First run: ~90 MB download. Subsequent runs use cache.
# WARNING: Changing this model requires deleting storage/chroma_db/ and re-uploading all docs.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Storage Paths ===
UPLOAD_DIR=./storage/uploads
CHROMA_PERSIST_DIRECTORY=./storage/chroma_db

# === Processing Parameters ===
# Maximum PDF upload size in megabytes
MAX_UPLOAD_SIZE_MB=50

# RAG chunking configuration
# chunk_size: target characters per chunk (all-MiniLM-L6-v2 max is ~1024 chars / 256 tokens)
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Number of chunks to retrieve per query (Q&A default)
RETRIEVAL_TOP_K=5

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# === CORS ===
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
